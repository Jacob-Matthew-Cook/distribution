    arm-pmu {
        compatible = "arm,cortex-a35-pmu";
        interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
        interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
    };
    bus_soc: bus-soc {
        compatible = "rockchip,px30-bus";
        rockchip,busfreq-policy = "autocs";
        soc-bus0 {
            bus-id = <0>;
            timer-us = <20>;
            enable-msk = <16631>;
        };
        soc-bus1 {
            bus-id = <1>;
            timer-us = <200>;
            enable-msk = <16575>;
            status = "disabled";
        };
        soc-bus2 {
            bus-id = <2>;
            timer-us = <200>;
            enable-msk = <16391>;
            status = "disabled";
        };
    };
    bus_apll: bus-apll {
        compatible = "rockchip,px30-bus";
        rockchip,busfreq-policy = "clkfreq";
        clocks = <&cru 1>;
        clock-names = "bus";
        operating-points-v2 = <&bus_apll_opp_table>;
        status = "okay";
        bus-supply = <&vdd_logic>;
    };
    bus_apll_opp_table: bus-apll-opp-table {
        compatible = "operating-points-v2";
        opp-shared;
        opp-1512000000 {
            opp-hz = <0 1512000000>;
            opp-microvolt = <1000000>;
        };
        opp-1008000000 {
            opp-hz = <0 1008000000>;
            opp-microvolt = <950000>;
        };
    };
    cpuinfo {
        compatible = "rockchip,cpuinfo";
        nvmem-cells = <15>;
        nvmem-cell-names = "id";
    };
    display_subsystem: display-subsystem {
        compatible = "rockchip,display-subsystem";
        ports = <&vopb_out>;
        status = "okay";
        logo-memory-region = <17>;
        route {
            route_lvds: route-lvds {
                status = "disabled";
                logo,uboot = "logo.bmp";
                logo,kernel = "logo_kernel.bmp";
                logo,mode = "center";
                charge_logo,mode = "center";
                connect = <18>;
            };
            route_dsi: route-dsi {
                status = "okay";
                logo,uboot = "logo.bmp";
                logo,kernel = "logo_kernel.bmp";
                logo,mode = "center";
                charge_logo,mode = "center";
                connect = <19>;
            };
            route_rgb: route-rgb {
                status = "disabled";
                logo,uboot = "logo.bmp";
                logo,kernel = "logo_kernel.bmp";
                logo,mode = "center";
                charge_logo,mode = "center";
                connect = <20>;
            };
        };
    };
    firmware {
        optee: optee {
            compatible = "linaro,optee-tz";
            method = "smc";
        };
        scmi: scmi {
            compatible = "arm,scmi-smc";
            shmem = <21>;
            arm,smc-id = <2181038096>;
            #address-cells = <1>;
            #size-cells = <0>;
            scmi_clk: protocol@14 {
                reg = <0x14>;
                #clock-cells = <1>;
            };
        };
        sdei: sdei {
            compatible = "arm,sdei-1.0";
            method = "smc";
        };
    };
    gmac_clkin: external-gmac-clock {
        compatible = "fixed-clock";
        clock-frequency = <50000000>;
        clock-output-names = "gmac_clkin";
        #clock-cells = <0>;
    };
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };
    rockchip_suspend: rockchip-suspend {
        compatible = "rockchip,pm-px30";
        status = "okay";
        rockchip,sleep-debug-en = <0>;
        rockchip,sleep-mode-config = <132866>;
        rockchip,wakeup-config = <133>;
    };
    timer {
        compatible = "arm,armv8-timer";
        interrupts = <GIC_PPI 13 3844>, <GIC_PPI 14 3844>, <GIC_PPI 11 3844>, <GIC_PPI 10 3844>;
    };
    thermal_zones: thermal-zones {
        soc_thermal: soc-thermal {
            polling-delay-passive = <20>;
            polling-delay = <1000>;
            sustainable-power = <750>;
            thermal-sensors = <&tsadc 0>;
            trips {
                threshold: trip-point-0 {
                    temperature = <70000>;
                    hysteresis = <2000>;
                    type = "passive";
                };
                target: trip-point-1 {
                    temperature = <85000>;
                    hysteresis = <2000>;
                    type = "passive";
                };
                soc_crit: soc-crit {
                    temperature = <115000>;
                    hysteresis = <2000>;
                    type = "critical";
                };
            };
            cooling-maps {
                map0 {
                    trip = <&target>;
                    cooling-device = <&cpu0 4294967295 4294967295>;
                    contribution = <4096>;
                };
                map1 {
                    trip = <&target>;
                    cooling-device = <&gpu 4294967295 4294967295>;
                    contribution = <4096>;
                };
            };
        };
        gpu_thermal: gpu-thermal {
            polling-delay-passive = <100>;
            polling-delay = <1000>;
            thermal-sensors = <&tsadc 1>;
        };
    };
    xin24m: xin24m {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
        clock-output-names = "xin24m";
    };
    xin32k: xin32k {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <32768>;
        clock-output-names = "xin32k";
    };
    scmi_shmem: scmi-shmem@10f000 {
        compatible = "arm,scmi-shmem";
        reg = <0x0 0x10f000 0 0x100>;
    };
    pmu: power-management@ff000000 {
        compatible = "rockchip,px30-pmu", "syscon", "simple-mfd";
        reg = <0x0 0xff000000 0 0x1000>;
        power: power-controller {
            compatible = "rockchip,px30-power-controller";
            #power-domain-cells = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
            power-domain@5 {
                reg = <0x5>;
                clocks = <&cru 259>, <&cru 258>, <&cru 60>;
                pm_qos = <&qos_usb_host>, <&qos_usb_otg>;
            };
            power-domain@7 {
                reg = <0x7>;
                clocks = <&cru 247>, <&cru 59>;
                pm_qos = <&qos_sdmmc>;
            };
            power-domain@9 {
                reg = <0x9>;
                clocks = <&cru 178>, <&cru 323>, <&cru 64>, <&cru 63>;
                pm_qos = <&qos_gmac>;
            };
            power-domain@10 {
                reg = <0xa>;
                clocks = <&cru 254>, <&cru 256>, <&cru 255>, <&cru 257>, <&cru 57>, <&cru 55>, <&cru 56>, <&cru 58>;
                pm_qos = <&qos_emmc>, <&qos_nand>, <&qos_sdio>, <&qos_sfc>;
            };
            power-domain@11 {
                reg = <0xb>;
                clocks = <&cru 175>, <&cru 244>, <&cru 75>;
                pm_qos = <&qos_vpu>, <&qos_vpu_r128>;
            };
            power-domain@12 {
                reg = <0xc>;
                clocks = <&cru 183>, <&cru 181>, <&cru 182>, <&cru 150>, <&cru 151>, <&cru 253>, <&cru 251>, <&cru 252>, <&cru 324>, <&cru 53>, <&cru 54>;
                pm_qos = <&qos_rga_rd>, <&qos_rga_wr>, <&qos_vop_m0>, <&qos_vop_m1>;
            };
            power-domain@13 {
                reg = <0xd>;
                clocks = <&cru 179>, <&cru 180>, <&cru 249>, <&cru 250>, <&cru 51>;
                pm_qos = <&qos_isp_128>, <&qos_isp_rd>, <&qos_isp_wr>, <&qos_isp_m1>, <&qos_vip>;
            };
            power-domain@14 {
                reg = <0xe>;
                clocks = <&cru 73>;
                pm_qos = <&qos_gpu>;
            };
        };
    };
    pmugrf: syscon@ff010000 {
        compatible = "rockchip,px30-pmugrf", "syscon", "simple-mfd";
        reg = <0x0 0xff010000 0 0x1000>;
        #address-cells = <1>;
        #size-cells = <1>;
        pmu_io_domains: io-domains {
            compatible = "rockchip,px30-pmu-io-voltage-domain";
            status = "okay";
            pmuio1-supply = <&vcc3v0_pmu>;
            pmuio2-supply = <&vcc3v0_pmu>;
        };
        reboot_mode: reboot-mode {
            compatible = "syscon-reboot-mode";
            offset = <512>;
            mode-bootloader = <1380107009>;
            mode-fastboot = <1380107017>;
            mode-loader = <1380107009>;
            mode-normal = <1380107008>;
            mode-recovery = <1380107011>;
            mode-charge = <1380107019>;
        };
        pmu_pvtm: pmu-pvtm {
            compatible = "rockchip,px30-pmu-pvtm";
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";
            pvtm@1 {
                reg = <0x1>;
                clocks = <&pmucru 7>;
                clock-names = "clk";
            };
        };
    };
    uart0: serial@ff030000 {
        compatible = "rockchip,px30-uart", "snps,dw-apb-uart";
        reg = <0x0 0xff030000 0 0x100>;
        interrupts = <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&pmucru 6>, <&pmucru 21>;
        clock-names = "baudclk", "apb_pclk";
        dmas = <&dmac 0>, <&dmac 1>;
        reg-shift = <2>;
        reg-io-width = <4>;
        pinctrl-names = "default";
        pinctrl-0 = <&uart0_xfer &uart0_cts &uart0_rts>;
        status = "disabled";
    };
    i2s0_8ch: i2s@ff060000 {
        compatible = "rockchip,px30-i2s-tdm";
        reg = <0x0 0xff060000 0 0x1000>;
        interrupts = <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&cru 16>, <&cru 18>, <&cru 262>;
        clock-names = "mclk_tx", "mclk_rx", "hclk";
        dmas = <&dmac 16>, <&dmac 17>;
        dma-names = "tx", "rx";
        resets = <&cru 132>, <&cru 191>;
        reset-names = "tx-m", "rx-m";
        rockchip,cru = <2>;
        rockchip,grf = <&grf>;
        pinctrl-names = "default";
        pinctrl-0 = <&i2s0_8ch_sclktx &i2s0_8ch_sclkrx &i2s0_8ch_lrcktx &i2s0_8ch_lrckrx &i2s0_8ch_sdi0>, <&i2s0_8ch_sdi1 &i2s0_8ch_sdi2 &i2s0_8ch_sdi3 &i2s0_8ch_sdo0 &i2s0_8ch_sdo1>, <&i2s0_8ch_sdo2 &i2s0_8ch_sdo3>;
        status = "disabled";
    };
    i2s1_2ch: i2s@ff070000 {
        compatible = "rockchip,px30-i2s", "rockchip,rk3066-i2s";
        reg = <0x0 0xff070000 0 0x1000>;
        interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&cru 20>, <&cru 263>;
        clock-names = "i2s_clk", "i2s_hclk";
        dmas = <&dmac 18>, <&dmac 19>;
        dma-names = "tx", "rx";
        pinctrl-names = "default";
        pinctrl-0 = <&i2s1_2ch_sclk &i2s1_2ch_lrck &i2s1_2ch_sdi &i2s1_2ch_sdo>;
        #sound-dai-cells = <0>;
        status = "okay";
    };
    i2s2_2ch: i2s@ff080000 {
        compatible = "rockchip,px30-i2s", "rockchip,rk3066-i2s";
        reg = <0x0 0xff080000 0 0x1000>;
        interrupts = <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&cru 22>, <&cru 264>;
        clock-names = "i2s_clk", "i2s_hclk";
        dmas = <&dmac 20>, <&dmac 21>;
        dma-names = "tx", "rx";
        pinctrl-names = "default";
        pinctrl-0 = <&i2s2_2ch_sclk &i2s2_2ch_lrck &i2s2_2ch_sdi &i2s2_2ch_sdo>;
        #sound-dai-cells = <0>;
        status = "disabled";
    };
    pdm: pdm@ff0a0000 {
        compatible = "rockchip,px30-pdm";
        reg = <0x0 0xff0a0000 0 0x1000>;
        clocks = <&cru 15>, <&cru 261>;
        clock-names = "pdm_clk", "pdm_hclk";
        dmas = <&dmac 24>;
        dma-names = "rx";
        resets = <&cru 130>;
        reset-names = "pdm-m";
        pinctrl-names = "default";
        pinctrl-0 = <&pdm_clk0m0 &pdm_clk1 &pdm_sdi0m0 &pdm_sdi1 &pdm_sdi2>, <&pdm_sdi3>;
        status = "disabled";
    };
    crypto: crypto@ff0b0000 {
        compatible = "rockchip,px30-crypto";
        reg = <0x0 0xff0b0000 0 0x400>, <0x0 0xff0b0480 0 0x3b80>;
        interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&cru 172>, <&cru 241>, <&cru 48>, <&cru 49>;
        clock-names = "aclk", "hclk", "sclk", "apb_pclk";
        resets = <&cru 116>;
        reset-names = "crypto-rst";
        status = "disabled";
    };
    rng: rng@ff0b0000 {
        compatible = "rockchip,cryptov2-rng";
        reg = <0x0 0xff0b0400 0 0x80>;
        clocks = <&cru 48>, <&cru 49>, <&cru 172>, <&cru 241>;
        clock-names = "clk_crypto", "clk_crypto_apk", "aclk_crypto", "hclk_crypto";
        assigned-clocks = <&cru 48>, <&cru 49>, <&cru 172>, <&cru 241>;
        assigned-clock-rates = <150000000 150000000 200000000 200000000>;
        resets = <&cru 116>;
        reset-names = "reset";
        status = "okay";
    };
    gic: interrupt-controller@ff131000 {
        compatible = "arm,gic-400";
        #interrupt-cells = <3>;
        #address-cells = <0>;
        interrupt-controller;
        reg = <0x0 0xff131000 0 0x1000>, <0x0 0xff132000 0 0x2000>, <0x0 0xff134000 0 0x2000>, <0x0 0xff136000 0 0x2000>;
        interrupts = <GIC_PPI 9 3844>;
    };
    grf: syscon@ff140000 {
        compatible = "rockchip,px30-grf", "syscon", "simple-mfd";
        reg = <0x0 0xff140000 0 0x1000>;
        #address-cells = <1>;
        #size-cells = <1>;
        io_domains: io-domains {
            compatible = "rockchip,px30-io-voltage-domain";
            status = "okay";
            vccio1-supply = <&vcc_3v0>;
            vccio2-supply = <&vccio_sd>;
            vccio3-supply = <&vcc_3v0>;
            vccio4-supply = <&vcc_3v0>;
            vccio5-supply = <&vcc_3v0>;
            vccio6-supply = <&vcc_3v0>;
        };
        lvds: lvds {
            compatible = "rockchip,px30-lvds";
            phys = <&dsi_dphy>;
            phy-names = "phy";
            status = "disabled";
            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0x0>;
                    #address-cells = <1>;
                    #size-cells = <0>;
                    lvds_vopb_in: endpoint@0 {
                        reg = <0x0>;
                        remote-endpoint = <&vopb_out_lvds>;
                    };
                };
            };
        };
        rgb: rgb {
            compatible = "rockchip,px30-rgb";
            pinctrl-names = "default", "sleep";
            pinctrl-0 = <&lcdc_m1_rgb_pins>;
            pinctrl-1 = <&lcdc_m1_sleep_pins>;
            status = "disabled";
            phys = <&dsi_dphy>;
            phy-names = "phy";
            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0x0>;
                    #address-cells = <1>;
                    #size-cells = <0>;
                    rgb_in_vopb: endpoint@0 {
                        reg = <0x0>;
                        remote-endpoint = <&vopb_out_rgb>;
                    };
                };
            };
        };
    };
    core_grf: syscon@ff148000 {
        compatible = "syscon", "simple-mfd";
        reg = <0x0 0xff148000 0 0x1000>;
        #address-cells = <1>;
        #size-cells = <1>;
        pvtm: pvtm {
            compatible = "rockchip,px30-pvtm";
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";
            pvtm@0 {
                reg = <0x0>;
                clocks = <&cru 74>;
                clock-names = "clk";
            };
        };
    };
    uart1: serial@ff158000 {
