        resets = <&cru 61>;
        reset-names = "apb";
        rockchip,grf = <&grf>;
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";
        ports {
            #address-cells = <1>;
            #size-cells = <0>;
            port@0 {
                reg = <0x0>;
                #address-cells = <1>;
                #size-cells = <0>;
                dsi_in_vopb: endpoint@0 {
                    reg = <0x0>;
                    remote-endpoint = <&vopb_out_dsi>;
                    status = "okay";
                };
            };
            port@1 {
                reg = <0x1>;
                dsi_out_panel: endpoint {
                    remote-endpoint = <&panel_in_dsi>;
                };
            };
        };
        panel@0 {
            compatible = "sitronix,st7703", "simple-panel-dsi";
            reg = <0x0>;
            backlight = <&backlight>;
            power-supply = <&vcc_mipi_lcd0>;
            enable-gpios = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
            reset-gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
            pinctrl-names = "default";
            pinctrl-0 = <&dsi0_lcd_gpio>;
            rotation = <90>;
            prepare-delay-ms = <2>;
            reset-delay-ms = <1>;
            init-delay-ms = <20>;
            enable-delay-ms = <120>;
            disable-delay-ms = <50>;
            unprepare-delay-ms = <20>;
            width-mm = <68>;
            height-mm = <121>;
            dsi,flags = <2563>;
            dsi,format = <0>;
            dsi,lanes = <2>;
            panel-init-sequence = [39 00 06 FF 77 01 00 00 13 15 00 02 EF 08 39 00 06 FF 77 01 00 00 10 39 00 03 C0 4F 00 39 00 03 C1 10 0C 39 00 03 C2 01 14 15 00 02 CC 10 39 00 11 B0 00 0B 13 0D 10 07 02 08 07 1F 04 11 0F 28 2F 1F 39 00 11 B1 00 0C 13 0C 10 05 02 08 08 1E 05 13 11 27 30 1F 39 00 06 FF 77 01 00 00 11 15 00 02 B0 4D 15 00 02 B1 4D 15 00 02 B2 87 15 00 02 B3 80 15 00 02 B5 45 15 00 02 B7 85 15 00 02 B8 20 15 00 02 C0 09 15 00 02 C1 78 15 00 02 C2 78 15 64 02 D0 88 39 00 04 E0 00 00 02 39 00 0C E1 04 B0 06 B0 05 B0 07 B0 00 44 44 39 00 0D E2 20 20 44 44 96 A0 00 00 96 A0 00 00 39 00 05 E3 00 00 22 22 39 00 03 E4 44 44 39 00 11 E5 0C 90 B0 A0 0E 92 B0 A0 08 8C B0 A0 0A 8E B0 A0 39 00 05 E6 00 00 22 22 39 00 03 E7 44 44 39 00 11 E8 0D 91 B0 A0 0F 93 B0 A0 09 8D B0 A0 0B 8F B0 A0 39 00 03 E9 36 00 39 00 08 EB 00 00 E4 E4 44 88 40 39 00 11 ED C1 A2 BF 0F 67 45 FF FF FF FF 54 76 F0 FB 2A 1C 39 00 07 EF 10 0D 04 08 3F 1F 39 00 06 FF 77 01 00 00 13 39 00 03 E8 00 0E 39 00 06 FF 77 01 00 00 00 05 78 01 11 39 00 06 FF 77 01 00 00 13 39 0A 03 E8 00 0C 39 00 03 E8 00 00 39 00 06 FF 77 01 00 00 00 05 32 01 29];
            panel-exit-sequence = [05 00 01 28 05 00 01 10];
            display-timings {
                native-mode = <&timing0>;
                timing0: timing0 {
                    clock-frequency = <25000000>;
                    hactive = <480>;
                    vactive = <640>;
                    hfront-porch = <40>;
                    hsync-len = <10>;
                    hback-porch = <40>;
                    vfront-porch = <40>;
                    vsync-len = <10>;
                    vback-porch = <40>;
                    hsync-active = <0>;
                    vsync-active = <0>;
                    de-active = <0>;
                    pixelclk-active = <0>;
                };
            };
            ports {
                #address-cells = <1>;
                #size-cells = <0>;
                port@0 {
                    reg = <0x0>;
                    panel_in_dsi: endpoint {
                        remote-endpoint = <&dsi_out_panel>;
                    };
                };
            };
        };
    };
    vopb: vop@ff460000 {
        compatible = "rockchip,px30-vop-big";
        reg = <0x0 0xff460000 0 0x260>, <0x0 0xff460a00 0 0x400>;
        rockchip,grf = <&grf>;
        reg-names = "regs", "gamma_lut";
        interrupts = <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&cru 181>, <&cru 150>, <&cru 251>;
        clock-names = "aclk_vop", "dclk_vop", "hclk_vop";
        resets = <&cru 51>, <&cru 52>, <&cru 53>;
        reset-names = "axi", "ahb", "dclk";
        iommus = <&vopb_mmu>;
        power-domains = <&power 12>;
        status = "okay";
        vopb_out: port {
            #address-cells = <1>;
            #size-cells = <0>;
            vopb_out_dsi: endpoint@0 {
                reg = <0x0>;
                remote-endpoint = <&dsi_in_vopb>;
            };
            vopb_out_lvds: endpoint@1 {
                reg = <0x1>;
                remote-endpoint = <&lvds_vopb_in>;
            };
            vopb_out_rgb: endpoint@2 {
                reg = <0x2>;
                remote-endpoint = <&rgb_in_vopb>;
            };
        };
    };
    vopb_mmu: iommu@ff460f00 {
        compatible = "rockchip,iommu";
        reg = <0x0 0xff460f00 0 0x100>;
        interrupts = <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>;
        interrupt-names = "vopb_mmu";
        clocks = <&cru 181>, <&cru 251>;
        clock-names = "aclk", "iface";
        power-domains = <&power 12>;
        #iommu-cells = <0>;
        rockchip,disable-device-link-resume;
        status = "okay";
    };
    rk_rga: rk_rga@ff480000 {
        compatible = "rockchip,rga2";
        reg = <0x0 0xff480000 0 0x1000>;
        interrupts = <GIC_SPI 76 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&cru 183>, <&cru 253>, <&cru 53>;
        clock-names = "aclk_rga", "hclk_rga", "clk_rga";
