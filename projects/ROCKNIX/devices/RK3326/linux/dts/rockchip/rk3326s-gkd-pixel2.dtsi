        dram_dq_odt_en_freq = <800>;
        phy_odt_en_freq = <800>;
        phy_dq_sr_odten = <7>;
        phy_ca_sr_odten = <1>;
        phy_clk_sr_odten = <1>;
        phy_dq_sr_odtoff = <7>;
        phy_ca_sr_odtoff = <1>;
        phy_clk_sr_odtoff = <1>;
        ssmod_downspread = <0>;
        ssmod_div = <0>;
        ssmod_spread = <0>;
        mode_2t = <0>;
        speed_bin = <0>;
        dram_ext_temp = <0>;
        byte_map = <228>;
        dq_map_cs0_dq_l = <0>;
        dq_map_cs0_dq_h = <0>;
        dq_map_cs1_dq_l = <0>;
        dq_map_cs1_dq_h = <0>;
        lp4_ca_odt = <120>;
        lp4_drv_pu_cal_odten = <0>;
        lp4_drv_pu_cal_odtoff = <0>;
        phy_lp4_drv_pulldown_en_odten = <0>;
        phy_lp4_drv_pulldown_en_odtoff = <0>;
        lp4_ca_odt_en_freq = <800>;
        phy_lp4_cs_drv_odten = <0>;
        phy_lp4_cs_drv_odtoff = <0>;
        lp4_odte_ck_en = <1>;
        lp4_odte_cs_en = <1>;
        lp4_odtd_ca_en = <0>;
        phy_lp4_dq_vref_odten = <200>;
        lp4_dq_vref_odten = <276>;
        lp4_ca_vref_odten = <380>;
        phy_lp4_dq_vref_odtoff = <420>;
        lp4_dq_vref_odtoff = <420>;
