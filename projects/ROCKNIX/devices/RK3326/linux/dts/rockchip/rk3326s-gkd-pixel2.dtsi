    dmc: dmc {
        compatible = "rockchip,px30-dmc";
        interrupts = <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
        interrupt-names = "complete_irq";
        devfreq-events = <&dfi>;
        clocks = <&cru 84>;
        clock-names = "dmc_clk";
        operating-points-v2 = <&dmc_opp_table>;
        ddr_timing = <176>;
        upthreshold = <40>;
        downdifferential = <20>;
        system-status-freq = <1 666000 8 450000 2 194000 32 450000 4096 666000 16384 666000 8192 1056000>;
        auto-min-freq = <328000>;
        auto-freq-en = <1>;
        #cooling-cells = <2>;
        status = "okay";
        center-supply = <&vdd_logic>;
        ddr_power_model: ddr_power_model {
            compatible = "ddr_power_model";
            dynamic-power-coefficient = <120>;
            static-power-coefficient = <200>;
            ts = <32000 4700 4294967216 2>;
            thermal-zone = "soc-thermal";
        };
    };
    dmc_fsp: dmc-fsp {
        compatible = "rockchip,px30s-dmc-fsp";
        debug_print_level = <0>;
        phy_de_skew_en = <1>;
        ddr3_params = <177>;
        ddr4_params = <178>;
        lpddr2_params = <179>;
        lpddr3_params = <180>;
        lpddr4_params = <181>;
        ddr_timing = <176>;
        status = "okay";
    };
    dmc_opp_table: dmc-opp-table {
        compatible = "operating-points-v2";
        rockchip,max-volt = <1150000>;
        rockchip,evb-irdrop = <25000>;
        rockchip,pvtm-voltage-sel = <0 50000 0 50001 54000 1 54001 60000 2 60001 99999 3>;
        rockchip,pvtm-ch = <0 0>;
        opp-194000000 {
            opp-hz = <0 194000000>;
            opp-microvolt = <950000>;
            opp-microvolt-L0 = <950000>;
            opp-microvolt-L1 = <950000>;
            opp-microvolt-L2 = <950000>;
            opp-microvolt-L3 = <950000>;
        };
        opp-328000000 {
            opp-hz = <0 328000000>;
            opp-microvolt = <950000>;
            opp-microvolt-L0 = <950000>;
            opp-microvolt-L1 = <950000>;
            opp-microvolt-L2 = <950000>;
            opp-microvolt-L3 = <950000>;
        };
        opp-450000000 {
            opp-hz = <0 450000000>;
            opp-microvolt = <950000>;
            opp-microvolt-L0 = <950000>;
            opp-microvolt-L1 = <950000>;
            opp-microvolt-L2 = <950000>;
            opp-microvolt-L3 = <950000>;
        };
        opp-666000000 {
            opp-hz = <0 666000000>;
            opp-microvolt = <1050000>;
            opp-microvolt-L0 = <1050000>;
            opp-microvolt-L1 = <1000000>;
            opp-microvolt-L2 = <975000>;
            opp-microvolt-L3 = <950000>;
        };
        opp-786000000 {
            opp-hz = <0 786000000>;
            opp-microvolt = <1100000>;
            opp-microvolt-L0 = <1100000>;
            opp-microvolt-L1 = <1050000>;
            opp-microvolt-L2 = <1025000>;
            opp-microvolt-L3 = <1000000>;
            status = "disabled";
        };
    };
    px30s_dmc_opp_table: px30s-dmc-opp-table {
        compatible = "operating-points-v2";
        opp-194000000 {
            opp-hz = <0 194000000>;
