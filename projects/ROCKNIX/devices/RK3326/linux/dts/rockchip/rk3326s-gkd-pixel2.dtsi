    cpus {
        #address-cells = <2>;
        #size-cells = <0>;
        cpu0: cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a35";
            reg = <0x0 0x0>;
            enable-method = "psci";
            clocks = <&cru 7>;
            #cooling-cells = <2>;
            cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
            dynamic-power-coefficient = <90>;
            operating-points-v2 = <&cpu0_opp_table>;
            cpu-supply = <&vdd_arm>;
        };
        cpu1: cpu@1 {
            device_type = "cpu";
            compatible = "arm,cortex-a35";
            reg = <0x0 0x1>;
            enable-method = "psci";
            clocks = <&cru 7>;
            #cooling-cells = <2>;
            cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
            dynamic-power-coefficient = <90>;
            operating-points-v2 = <&cpu0_opp_table>;
        };
        cpu2: cpu@2 {
            device_type = "cpu";
            compatible = "arm,cortex-a35";
            reg = <0x0 0x2>;
            enable-method = "psci";
            clocks = <&cru 7>;
            #cooling-cells = <2>;
            cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
            dynamic-power-coefficient = <90>;
            operating-points-v2 = <&cpu0_opp_table>;
        };
        cpu3: cpu@3 {
            device_type = "cpu";
            compatible = "arm,cortex-a35";
            reg = <0x0 0x3>;
            enable-method = "psci";
            clocks = <&cru 7>;
            #cooling-cells = <2>;
            cpu-idle-states = <&CPU_SLEEP &CLUSTER_SLEEP>;
            dynamic-power-coefficient = <90>;
            operating-points-v2 = <&cpu0_opp_table>;
        };
        idle-states {
            entry-method = "psci";
            CPU_SLEEP: cpu-sleep {
                compatible = "arm,idle-state";
                local-timer-stop;
                arm,psci-suspend-param = <65536>;
                entry-latency-us = <120>;
                exit-latency-us = <250>;
                min-residency-us = <900>;
            };
            CLUSTER_SLEEP: cluster-sleep {
                compatible = "arm,idle-state";
                local-timer-stop;
                arm,psci-suspend-param = <16842752>;
                entry-latency-us = <400>;
                exit-latency-us = <500>;
                min-residency-us = <2000>;
            };
        };
    };
    cpu0_opp_table: cpu0-opp-table {
        compatible = "operating-points-v2";
