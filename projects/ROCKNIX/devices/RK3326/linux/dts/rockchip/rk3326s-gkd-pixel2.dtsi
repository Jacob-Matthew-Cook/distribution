    dsi: dsi@ff450000 {
        compatible = "rockchip,px30-mipi-dsi";
        reg = <0x0 0xff450000 0 0x10000>;
        interrupts = <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>;
        clocks = <&cru 324>;
        clock-names = "pclk";
        phys = <&dsi_dphy>;
