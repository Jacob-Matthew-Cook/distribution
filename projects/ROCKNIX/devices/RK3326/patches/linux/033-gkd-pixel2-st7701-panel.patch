--- linux.orig/drivers/gpu/drm/panel/panel-sitronix-st7701.c	2026-07-09 04:38:14.332653326 +0000
+++ linux/drivers/gpu/drm/panel/panel-sitronix-st7701.c	2026-07-09 19:26:57.642158072 +0000
@@ -137,6 +137,7 @@ struct st7701 {
 
 	struct regulator_bulk_data supplies[2];
 	struct gpio_desc *reset;
+	struct gpio_desc *enable_gpio;
 	unsigned int sleep_delay;
