+		 * (the max_1ghz table) on PX30S hardware skips the PLL post-
+		 * divider enable, the clock-lane VOD range register, and the
+		 * high-order bits of several timing counters entirely.
+		 */
+		.compatible = "rockchip,px30s-dsi-dphy",
