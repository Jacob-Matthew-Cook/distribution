+/*
+ * PX30S is a distinct chip variant from plain PX30, detected via a
+ * DDR_GRF_CON1 register bit (matching the vendor kernel's
+ * rockchip-cpuinfo.c px30_init()/soc_is_px30s()). On PX30S, powering off
+ * the GPU power domain (named "pd_gpu" in the vendor kernel's own table,
+ * "gpu" here since that's the string this mainline driver's own
+ * DOMAIN_PX30("gpu", ...) table entry uses for pd->genpd.name) through the
+ * normal genpd path is erratic and
+ * can corrupt the GPU clock's prepare/enable refcount (surfacing as e.g.
+ * "Enabling unprepared clk_gpu" warnings and -108/-ESHUTDOWN errors from
+ * clk_core_enable() on a later resume) - the vendor kernel works around
+ * this by simply never powering the domain off. This is not something a
+ * devicetree property can express (there is no distinct "px30s" power
+ * domain compatible string, unlike the otp/tsadc PX30S workarounds), so it
+ * needs this direct register-based detection.
+ */
+#define PX30_DDR_GRF_PHYS	0xFF630000
+#define PX30_DDR_GRF_CON1	0x04
+
+static bool rockchip_soc_is_px30s(void)
+{
+	static int px30s = -1;
+	void __iomem *base;
+
+	if (px30s >= 0)
+		return px30s;
+
+	px30s = 0;
+	if (of_machine_is_compatible("rockchip,px30") ||
+	    of_machine_is_compatible("rockchip,rk3326")) {
+		base = ioremap(PX30_DDR_GRF_PHYS, SZ_4K);
+		if (base) {
+			u32 val = readl_relaxed(base + PX30_DDR_GRF_CON1);
+
+			if (((val >> 14) & 0x03) == 0x03)
+				px30s = 1;
+			iounmap(base);
+		}
+	}
+
+	return px30s;
+}
+
