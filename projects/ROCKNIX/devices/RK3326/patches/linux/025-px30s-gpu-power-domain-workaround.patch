--- a/drivers/pmdomain/rockchip/pm-domains.c
+++ b/drivers/pmdomain/rockchip/pm-domains.c
@@ -35,6 +35,7 @@
 #include <dt-bindings/power/rk3568-power.h>
 #include <dt-bindings/power/rockchip,rk3576-power.h>
 #include <dt-bindings/power/rk3588-power.h>
+#include <linux/rockchip/cpu.h>
 
 struct rockchip_domain_info {
 	const char *name;
@@ -574,6 +575,24 @@
 	struct rockchip_pmu *pmu = pd->pmu;
 	int ret;
 
+	/*
+	 * Ported from the vendor kernel's 41f9bdf3cf40 ("soc: rockchip:
+	 * power-domain: keep pd_gpu always on for px30s"), corrected per the
+	 * follow-up fix 480163a87a56 ("soc: rockchip: power-domain: correct
+	 * name of pd_gpu for px30s") - the original patch compared against
+	 * "pd_gpu", but the genpd's actual name (both there and in this
+	 * mainline driver's own DOMAIN_PX30("gpu", ...) table entry) is just
+	 * "gpu", so the original check never matched anything. Powering off
+	 * the GPU domain through the normal genpd path on PX30S is erratic
+	 * and can corrupt the GPU clock's prepare/enable refcount (surfacing
+	 * as e.g. "Enabling unprepared clk_gpu" warnings and -108/-ESHUTDOWN
+	 * errors from clk_core_enable() on a later resume) - the vendor
+	 * kernel works around this by simply never powering the domain off.
+	 */
+	if (!power_on && soc_is_px30s() &&
+	    pd->genpd.name && !strcmp(pd->genpd.name, "gpu"))
+		return 0;
+
 	mutex_lock(&pmu->mutex);
 
 	if (rockchip_pmu_domain_is_on(pd) != power_on) {
