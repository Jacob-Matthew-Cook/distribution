--- a/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
@@ -11,9 +11,11 @@
 #include <linux/math64.h>
 #include <linux/mfd/syscon.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/of_device.h>
 #include <linux/of_platform.h>
 #include <linux/phy/phy.h>
+#include <linux/phy/phy-mipi-dphy.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/regmap.h>
@@ -583,14 +585,45 @@
 				      "DPHY clock frequency is out of range\n");
 	}
 
+	/*
+	 * Optional devicetree override: some panels need a specific lane
+	 * bitrate rather than this driver's auto-calculated (1/0.8 margin)
+	 * target. E.g. a vendor BSP kernel's own DSI host driver uses a
+	 * 1/0.9 margin instead - a real, confirmed-working target_mbps for
+	 * a given mode/format/lanes combination that differs from what this
+	 * driver computes. Falls back to the calculated value above if the
+	 * property is absent, so this is a no-op for every other board.
+	 */
+	of_property_read_u32(dsi->dev->of_node, "rockchip,mipi-dsi-target-mbps",
+			      &target_mbps);
+
 	/* for external phy only a the mipi_dphy_config is necessary */
 	if (dsi->phy) {
-		phy_mipi_dphy_get_default_config(mode->clock * 1000 * 10 / 8,
-						 bpp, lanes,
-						 &dsi->phy_opts.mipi_dphy);
+		/*
+		 * phy_mipi_dphy_get_default_config() independently recomputes
+		 * its own hs_clk_rate from mode->clock with the same hardcoded
+		 * 1/0.8 margin used above - it does not consult target_mbps at
+		 * all, so the devicetree override above would otherwise be
+		 * silently ignored on boards (like this one) that use an
+		 * external phy. Use the _for_hsclk() variant instead so an
+		 * explicit override actually reaches the real PHY timing
+		 * configuration, not just dsi->lane_mbps.
+		 */
+		phy_mipi_dphy_get_default_config_for_hsclk(
+			(unsigned long long)target_mbps * USEC_PER_SEC,
+			lanes, &dsi->phy_opts.mipi_dphy);
 		dsi->lane_mbps = target_mbps;
 		*lane_mbps = dsi->lane_mbps;
 
+		dev_info(dsi->dev,
+			 "px30s diag: target_mbps=%u hs_clk_rate=%lu hs_zero=%u hs_prepare=%u hs_settle=%u clk_zero=%u clk_prepare=%u\n",
+			 target_mbps, dsi->phy_opts.mipi_dphy.hs_clk_rate,
+			 dsi->phy_opts.mipi_dphy.hs_zero,
+			 dsi->phy_opts.mipi_dphy.hs_prepare,
+			 dsi->phy_opts.mipi_dphy.hs_settle,
+			 dsi->phy_opts.mipi_dphy.clk_zero,
+			 dsi->phy_opts.mipi_dphy.clk_prepare);
+
 		return 0;
 	}
 
