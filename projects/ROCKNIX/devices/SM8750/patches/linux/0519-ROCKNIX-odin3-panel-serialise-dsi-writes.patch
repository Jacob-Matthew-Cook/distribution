From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob Cook <jacobmcook1984@gmail.com>
Date: Wed, 28 Oct 2026 10:15:09 -0400
Subject: [PATCH] drm/panel: icna35xx: serialise DSI writes with a panel lock

The backlight update, the frame length store and enable()/disable() share
enabled and the DSI LPM bit without a lock, so their writes can interleave
or land on a panel that is being disabled. Take one panel lock around them
and always restore the LPM bit.

The backlight is not registered with drm_panel, so nothing re-applies a
level that was skipped between prepare() and enable(). Mark skipped writes
and send the cached level from enable().

prepare() still sends its init sequence unlocked. That is safe because
enabled stays false until enable(), so the other writers back off.
---
 drivers/gpu/drm/panel/panel-chipone-icna35xx.c | 39 +++++++++++++++++++++-----
 1 file changed, 32 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
index b279bfa..165c30a 100644
--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
@@ -9,6 +9,7 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
@@ -33,7 +34,10 @@ struct panel_info {
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
 	struct backlight_device *backlight;
+	/* Serialises enabled with the backlight and frame length writes */
+	struct mutex lock;
 	bool enabled;
+	bool bl_pending;
 
 	int vrefresh;
 	u16 frame_len_120;
@@ -360,6 +364,10 @@ static int icna35xx_prepare(struct drm_panel *panel)
 
 	icna35xx_reset(pinfo);
 
+	/* init_sequence() sends the cached level; later skipped writes set bl_pending */
+	scoped_guard(mutex, &pinfo->lock)
+		pinfo->bl_pending = false;
+
 	ret = pinfo->desc->init_sequence(pinfo);
 	if (ret < 0) {
         regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
@@ -375,6 +383,7 @@ static int icna35xx_disable(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
 
+	guard(mutex)(&pinfo->lock);
 	pinfo->enabled = false;
 
 	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
@@ -452,10 +461,22 @@ static enum drm_panel_orientation icna35xx_get_orientation(struct drm_panel *pan
 static int icna35xx_enable(struct drm_panel *panel)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
+	struct mipi_dsi_device *dsi = pinfo->dsi;
+	int ret;
 
+	guard(mutex)(&pinfo->lock);
 	pinfo->enabled = true;
 
-	return 0;
+	if (!pinfo->bl_pending)
+		return 0;
+
+	pinfo->bl_pending = false;
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi,
+			backlight_get_brightness(pinfo->backlight));
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret < 0 ? ret : 0;
 }
 
 static const struct drm_panel_funcs icna35xx_panel_funcs = {
@@ -481,18 +502,17 @@ static int icna35xx_bl_update_status(struct backlight_device *bl)
 	 * is cached by the backlight core and re-applied from init_sequence()
 	 * on every prepare(), so skipping the write while disabled is safe.
 	 */
-	if (!pinfo->enabled)
+	guard(mutex)(&pinfo->lock);
+	if (!pinfo->enabled) {
+		pinfo->bl_pending = true;
 		return 0;
+	}
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
-
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	return 0;
+	return ret < 0 ? ret : 0;
 }
 
 static int icna35xx_bl_get_brightness(struct backlight_device *bl)
@@ -534,6 +554,7 @@ static ssize_t icna3520_frame_len_store(struct device *dev, u16 *frame_len,
 	if (val < min || val > max)
 		return -EINVAL;
 
+	guard(mutex)(&pinfo->lock);
 	*frame_len = val;
 
 	if (!pinfo->enabled || pinfo->vrefresh != vrefresh)
@@ -610,6 +631,10 @@ static int icna35xx_probe(struct mipi_dsi_device *dsi)
 	if (IS_ERR(pinfo))
 		return PTR_ERR(pinfo);
 
+	ret = devm_mutex_init(dev, &pinfo->lock);
+	if (ret)
+		return ret;
+
 	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
 	panel_supplies, &pinfo->supplies);
 	if (ret < 0){
