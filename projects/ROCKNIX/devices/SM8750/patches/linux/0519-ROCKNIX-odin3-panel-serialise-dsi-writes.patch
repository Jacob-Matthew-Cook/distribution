From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob Cook <jacobmcook1984@gmail.com>
Date: Wed, 28 Oct 2026 09:46:22 -0400
Subject: [PATCH] drm/panel: icna35xx: serialise DSI writes with a panel lock

The backlight update, the frame length store and enable()/disable() share
enabled and the DSI LPM bit without a lock, so their writes can interleave
or land on a panel that is being disabled. Take one panel lock around them
and always restore the LPM bit.
---
 drivers/gpu/drm/panel/panel-chipone-icna35xx.c | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
index b279bfa..5eca0ce 100644
--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
@@ -9,6 +9,7 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
@@ -33,6 +34,8 @@ struct panel_info {
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
 	struct backlight_device *backlight;
+	/* Serialises enabled with the backlight and frame length writes */
+	struct mutex lock;
 	bool enabled;
 
 	int vrefresh;
@@ -375,6 +378,7 @@ static int icna35xx_disable(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
 
+	guard(mutex)(&pinfo->lock);
 	pinfo->enabled = false;
 
 	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
@@ -453,6 +457,7 @@ static int icna35xx_enable(struct drm_panel *panel)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
 
+	guard(mutex)(&pinfo->lock);
 	pinfo->enabled = true;
 
 	return 0;
@@ -481,18 +486,15 @@ static int icna35xx_bl_update_status(struct backlight_device *bl)
 	 * is cached by the backlight core and re-applied from init_sequence()
 	 * on every prepare(), so skipping the write while disabled is safe.
 	 */
+	guard(mutex)(&pinfo->lock);
 	if (!pinfo->enabled)
 		return 0;
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
-
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	return 0;
+	return ret < 0 ? ret : 0;
 }
 
 static int icna35xx_bl_get_brightness(struct backlight_device *bl)
@@ -534,6 +536,7 @@ static ssize_t icna3520_frame_len_store(struct device *dev, u16 *frame_len,
 	if (val < min || val > max)
 		return -EINVAL;
 
+	guard(mutex)(&pinfo->lock);
 	*frame_len = val;
 
 	if (!pinfo->enabled || pinfo->vrefresh != vrefresh)
@@ -610,6 +613,10 @@ static int icna35xx_probe(struct mipi_dsi_device *dsi)
 	if (IS_ERR(pinfo))
 		return PTR_ERR(pinfo);
 
+	ret = devm_mutex_init(dev, &pinfo->lock);
+	if (ret)
+		return ret;
+
 	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
 	panel_supplies, &pinfo->supplies);
 	if (ret < 0){
