From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob Cook <jacobmcook1984@gmail.com>
Date: Wed, 28 Oct 2026 09:46:22 -0400
Subject: [PATCH] drm/panel: vtdr6130-cog: serialise DSI writes with a panel lock

The backlight ops, the frame length store and disable() all toggle the DSI
LPM bit and send commands without a lock, so they can interleave or land on
a panel that is being disabled. Take one panel lock around them, skip
backlight writes while the panel is off (drm_panel_enable() re-applies the
level), always restore the LPM bit, and report the cached brightness
instead of reading it back over DSI.
---
 .../gpu/drm/panel/panel-visionox-vtdr6130-cog.c    | 36 +++++++++++-----------
 1 file changed, 18 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
index 71b958f..d5b0868 100644
--- a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
+++ b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
@@ -9,6 +9,7 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
@@ -32,6 +33,8 @@ struct panel_info {
 
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+	/* Serialises enabled with the backlight and frame length writes */
+	struct mutex lock;
 	bool enabled;
 
 	u16 frame_len_120;
@@ -303,6 +306,7 @@ static int vtdr6130_enable(struct drm_panel *panel)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
 
+	guard(mutex)(&pinfo->lock);
 	pinfo->enabled = true;
 
 	return 0;
@@ -313,6 +317,7 @@ static int vtdr6130_disable(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
 
+	guard(mutex)(&pinfo->lock);
 	pinfo->enabled = false;
 
 	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
@@ -399,35 +404,25 @@ static const struct drm_panel_funcs vtdr6130_panel_funcs = {
 static int vtdr6130_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	/* drm_panel_enable() re-applies the level once the panel is on */
+	guard(mutex)(&pinfo->lock);
+	if (!pinfo->enabled)
+		return 0;
 
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
-
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	return 0;
+	return ret < 0 ? ret : 0;
 }
 
 static int vtdr6130_bl_get_brightness(struct backlight_device *bl)
 {
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness;
-	int ret;
-
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-	if (ret < 0)
-		return ret;
-
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return brightness;
+	return backlight_get_brightness(bl);
 }
 
 static const struct backlight_ops vtdr6130_bl_ops = {
@@ -464,6 +459,7 @@ static ssize_t vtdr6130_rp6_frame_len_store(struct device *dev, u16 *frame_len,
 	if (val < min || val > max)
 		return -EINVAL;
 
+	guard(mutex)(&pinfo->lock);
 	*frame_len = val;
 
 	if (!pinfo->enabled)
@@ -536,6 +532,10 @@ static int vtdr6130_probe(struct mipi_dsi_device *dsi)
 	if (IS_ERR(pinfo))
 		return PTR_ERR(pinfo);
 
+	ret = devm_mutex_init(dev, &pinfo->lock);
+	if (ret)
+		return ret;
+
 	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
 	panel_supplies, &pinfo->supplies);
 	if (ret < 0){
