From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jacob Cook <jacobmcook1984@gmail.com>
Date: Wed, 28 Oct 2026 09:46:22 -0400
Subject: [PATCH] drm/panel: icna35xx: serialise DSI writes with a panel lock

The backlight ops, the frame length store and disable() all toggle the DSI
LPM bit and send commands without a lock, so they can interleave or land on
a panel that is being disabled. Take one panel lock around them, skip
backlight writes while the panel is off (drm_panel_enable() re-applies the
level), always restore the LPM bit, and report the cached brightness
instead of reading it back over DSI.

Set enabled from enable() instead of prepare(), so nothing is sent to the
panel before the DSI stream starts.
---
 drivers/gpu/drm/panel/panel-chipone-icna35xx.c | 48 +++++++++++++++-----------
 1 file changed, 28 insertions(+), 20 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
index 080d308..f11ffd4 100644
--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
@@ -9,6 +9,7 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
@@ -32,6 +33,8 @@ struct panel_info {
 
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+	/* Serialises enabled with the backlight and frame length writes */
+	struct mutex lock;
 	bool enabled;
 
 	int vrefresh;
@@ -358,8 +361,6 @@ static int icna35xx_prepare(struct drm_panel *panel)
 		return ret;
 	}
 
-	pinfo->enabled = true;
-
 	return 0;
 }
 
@@ -368,6 +369,7 @@ static int icna35xx_disable(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
 
+	guard(mutex)(&pinfo->lock);
 	pinfo->enabled = false;
 	pinfo->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
@@ -441,9 +443,20 @@ static enum drm_panel_orientation icna35xx_get_orientation(struct drm_panel *pan
 	return pinfo->orientation;
 }
 
+static int icna35xx_enable(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+
+	guard(mutex)(&pinfo->lock);
+	pinfo->enabled = true;
+
+	return 0;
+}
+
 static const struct drm_panel_funcs icna35xx_panel_funcs = {
 	.disable = icna35xx_disable,
 	.prepare = icna35xx_prepare,
+	.enable = icna35xx_enable,
 	.unprepare = icna35xx_unprepare,
 	.get_modes = icna35xx_get_modes,
 	.get_orientation = icna35xx_get_orientation,
@@ -452,35 +465,25 @@ static const struct drm_panel_funcs icna35xx_panel_funcs = {
 static int icna35xx_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	/* drm_panel_enable() re-applies the level once the panel is on */
+	guard(mutex)(&pinfo->lock);
+	if (!pinfo->enabled)
+		return 0;
 
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
-
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	return 0;
+	return ret < 0 ? ret : 0;
 }
 
 static int icna35xx_bl_get_brightness(struct backlight_device *bl)
 {
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness;
-	int ret;
-
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-	if (ret < 0)
-		return ret;
-
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return brightness;
+	return backlight_get_brightness(bl);
 }
 
 static const struct backlight_ops icna35xx_bl_ops = {
@@ -517,6 +520,7 @@ static ssize_t icna3520_frame_len_store(struct device *dev, u16 *frame_len,
 	if (val < min || val > max)
 		return -EINVAL;
 
+	guard(mutex)(&pinfo->lock);
 	*frame_len = val;
 
 	if (!pinfo->enabled || pinfo->vrefresh != vrefresh)
@@ -592,6 +596,10 @@ static int icna35xx_probe(struct mipi_dsi_device *dsi)
 	if (IS_ERR(pinfo))
 		return PTR_ERR(pinfo);
 
+	ret = devm_mutex_init(dev, &pinfo->lock);
+	if (ret)
+		return ret;
+
 	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
 	panel_supplies, &pinfo->supplies);
 	if (ret < 0){
