. /etc/profile.d/001-functions

### Drop the power-key override left behind while sleep was disabled.
rm -f /storage/.config/logind.conf.d/login.conf

### H700 firmware has no PSCI SYSTEM_SUSPEND, so "mem" is s2idle here.
MYSLEEPMODE=$(get_setting system.suspendmode)
if [ -z "${MYSLEEPMODE}" ]
then
  /usr/bin/suspendmode mem
fi
